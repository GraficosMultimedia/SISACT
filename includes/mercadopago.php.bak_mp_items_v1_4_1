<?php
declare(strict_types=1);

require_once __DIR__ . '/../config/runtime.php';
require_once __DIR__ . '/seguimiento.php';

function mp_config_path(): string
{
    return __DIR__ . '/../config/mercadopago.local.php';
}

function mp_config(): array
{
    static $cache = null;
    if (is_array($cache)) return $cache;

    $defaults = [
        'enabled' => false,
        'mode' => 'test',
        'access_token' => '',
        'base_url' => '',
        'currency' => 'MXN',
        'test_buyer_email' => '',
    ];

    $path = mp_config_path();
    if (!is_file($path)) return $cache = $defaults;

    try {
        $loaded = require $path;
        $cache = is_array($loaded)
            ? array_merge($defaults, $loaded)
            : $defaults;
    } catch (Throwable $e) {
        error_log('[SISACT][MercadoPago][config] '.$e->getMessage());
        $cache = $defaults;
    }

    $cache['enabled'] = (bool)$cache['enabled'];
    $cache['mode'] = in_array((string)$cache['mode'], ['test','production'], true)
        ? (string)$cache['mode']
        : 'test';
    $cache['access_token'] = trim((string)$cache['access_token']);
    $cache['base_url'] = rtrim(trim((string)$cache['base_url']), '/');
    $cache['currency'] = strtoupper(trim((string)$cache['currency'])) ?: 'MXN';
    $cache['test_buyer_email'] = strtolower(trim((string)$cache['test_buyer_email']));

    return $cache;
}

function mp_configured(): bool
{
    $c = mp_config();

    return $c['enabled']
        && $c['access_token'] !== ''
        && preg_match('#^https://#i', $c['base_url']) === 1;
}

function mp_table_ready(): bool
{
    try {
        $st = db()->query("SHOW TABLES LIKE 'cp_mercadopago_orders'");
        return (bool)$st->fetchColumn();
    } catch (Throwable $e) {
        return false;
    }
}

function mp_uuid4(): string
{
    $d = random_bytes(16);
    $d[6] = chr((ord($d[6]) & 0x0f) | 0x40);
    $d[8] = chr((ord($d[8]) & 0x3f) | 0x80);

    $h = bin2hex($d);

    return substr($h,0,8).'-'
        .substr($h,8,4).'-'
        .substr($h,12,4).'-'
        .substr($h,16,4).'-'
        .substr($h,20,12);
}

function mp_money_string(float $amount): string
{
    return number_format(round($amount, 2), 2, '.', '');
}

function mp_error_flatten(mixed $value, string $prefix = ''): array
{
    $out = [];

    if (is_scalar($value) || $value === null) {
        $text = trim((string)$value);

        if ($text !== '') {
            $out[] = ($prefix !== '' ? $prefix.'=' : '').$text;
        }

        return $out;
    }

    if (!is_array($value)) return $out;

    foreach ($value as $key => $child) {
        $keyText = is_string($key) ? $key : (string)$key;
        $next = $prefix === '' ? $keyText : $prefix.'.'.$keyText;

        $out = array_merge(
            $out,
            mp_error_flatten($child, $next)
        );
    }

    return $out;
}

function mp_error_message_from_response(int $http, array $data): string
{
    $lines = array_values(
        array_unique(
            array_filter(
                mp_error_flatten($data)
            )
        )
    );

    $summary = 'HTTP '.$http;

    if ($lines) {
        $summary .= ' | '.implode(' | ', $lines);
    }

    return mb_substr($summary, 0, 12000);
}

function mp_api_request(
    string $method,
    string $path,
    ?array $body = null,
    ?string $idempotencyKey = null
): array {
    $cfg = mp_config();

    if ($cfg['access_token'] === '') {
        throw new RuntimeException(
            'ACCESS_TOKEN_MISSING: falta el Access Token.'
        );
    }

    if (!function_exists('curl_init')) {
        throw new RuntimeException(
            'CURL_MISSING: PHP cURL no está disponible.'
        );
    }

    $url = str_starts_with($path, 'http')
        ? $path
        : 'https://api.mercadopago.com'.$path;

    $headers = [
        'Accept: application/json',
        'Content-Type: application/json',
        'Authorization: Bearer '.$cfg['access_token'],
    ];

    if ($idempotencyKey) {
        $headers[] = 'X-Idempotency-Key: '.$idempotencyKey;
    }

    $ch = curl_init($url);

    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_CUSTOMREQUEST => strtoupper($method),
        CURLOPT_HTTPHEADER => $headers,
        CURLOPT_CONNECTTIMEOUT => 8,
        CURLOPT_TIMEOUT => 25,
        CURLOPT_SSL_VERIFYPEER => true,
        CURLOPT_SSL_VERIFYHOST => 2,
    ]);

    if ($body !== null) {
        $json = json_encode(
            $body,
            JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
        );

        if ($json === false) {
            throw new RuntimeException(
                'JSON_ERROR: no se pudo preparar la solicitud.'
            );
        }

        curl_setopt($ch, CURLOPT_POSTFIELDS, $json);
    }

    $raw = curl_exec($ch);
    $curlError = curl_error($ch);
    $http = (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE);

    curl_close($ch);

    if ($raw === false || $curlError !== '') {
        throw new RuntimeException(
            'NETWORK_ERROR: '.$curlError
        );
    }

    $data = json_decode((string)$raw, true);

    if (!is_array($data)) {
        $data = [
            'raw_response' => mb_substr((string)$raw, 0, 4000)
        ];
    }

    if ($http < 200 || $http >= 300) {
        throw new RuntimeException(
            mp_error_message_from_response($http, $data)
        );
    }

    return $data;
}

function mp_test_access_token(): array
{
    try {
        $begin = rawurlencode(
            gmdate('Y-m-d\T00:00:00\Z', time()-86400)
        );

        $end = rawurlencode(
            gmdate('Y-m-d\T23:59:59\Z')
        );

        mp_api_request(
            'GET',
            '/v1/orders?begin_date='.$begin.'&end_date='.$end
        );

        return [
            'ok'=>true,
            'message'=>'Access Token aceptado por Orders API.'
        ];
    } catch (Throwable $e) {
        return [
            'ok'=>false,
            'message'=>$e->getMessage()
        ];
    }
}

function mp_order_customer_data(int $orderId): array
{
    $st = db()->prepare(
        'SELECT o.customer_id,o.order_number,o.total,o.status,
                c.name AS customer_name,c.email AS customer_email
         FROM cp_orders o
         LEFT JOIN cp_customers c ON c.id=o.customer_id
         WHERE o.id=?
         LIMIT 1'
    );

    $st->execute([$orderId]);

    return $st->fetch() ?: [];
}

function mp_public_context(int $orderId, array $finance): array
{
    $balance = round(
        (float)($finance['balance'] ?? 0),
        2
    );

    return [
        'configured'=>mp_configured(),
        'ready'=>mp_table_ready(),
        'balance'=>$balance,
        'show'=>mp_configured()
            && mp_table_ready()
            && $balance > 0.009,
    ];
}

function mp_recent_reusable_checkout(
    int $orderId,
    float $amount
): ?array {
    if (!mp_table_ready()) return null;

    $cutoff = date(
        'Y-m-d H:i:s',
        time()-1800
    );

    $st = db()->prepare(
        "SELECT *
         FROM cp_mercadopago_orders
         WHERE order_id=?
           AND ABS(amount-?)<0.01
           AND status IN ('created','processing','action_required')
           AND checkout_url IS NOT NULL
           AND checkout_url<>''
           AND created_at>=?
         ORDER BY id DESC
         LIMIT 1"
    );

    $st->execute([
        $orderId,
        $amount,
        $cutoff
    ]);

    return $st->fetch() ?: null;
}

function mp_save_error(
    int $localId,
    Throwable $error
): void {
    $message = mb_substr(
        $error->getMessage(),
        0,
        12000
    );

    try {
        db()->prepare(
            "UPDATE cp_mercadopago_orders
             SET status='error',
                 error_message=?,
                 updated_at=NOW()
             WHERE id=?"
        )->execute([
            $message,
            $localId
        ]);
    } catch (Throwable $storageError) {
        /*
         * Nunca reemplazar el error original por un error de diagnóstico.
         */
        error_log(
            '[SISACT][MercadoPago][error_storage] '
            .$storageError->getMessage()
        );
    }

    error_log(
        '[SISACT][MercadoPago][create_order] '
        .$message
    );
}

function mp_create_checkout(
    int $orderId,
    string $trackingToken
): array {
    if (!mp_configured()) {
        throw new RuntimeException(
            'MP_NOT_CONFIGURED: Mercado Pago todavía no está configurado.'
        );
    }

    if (!mp_table_ready()) {
        throw new RuntimeException(
            'MP_TABLE_MISSING: falta cp_mercadopago_orders.'
        );
    }

    $cfg = mp_config();

    $order = mp_order_customer_data(
        $orderId
    );

    if (!$order) {
        throw new RuntimeException(
            'ORDER_NOT_FOUND: la orden no existe.'
        );
    }

    if ((string)($order['status'] ?? '') === 'cancelled') {
        throw new RuntimeException(
            'ORDER_CANCELLED: esta orden está cancelada.'
        );
    }

    $finance = tracking_payment_summary(
        $orderId
    );

    $balance = round(
        (float)$finance['balance'],
        2
    );

    if ($balance <= 0.009) {
        throw new RuntimeException(
            'ORDER_PAID: la orden ya no tiene saldo pendiente.'
        );
    }

    $reuse = mp_recent_reusable_checkout(
        $orderId,
        $balance
    );

    if ($reuse && !empty($reuse['checkout_url'])) {
        return $reuse;
    }

    $customerId = (int)($order['customer_id'] ?? 0);
    $returnToken = bin2hex(
        random_bytes(32)
    );

    $idempotency = mp_uuid4();
    $currency = (string)$cfg['currency'];

    db()->prepare(
        "INSERT INTO cp_mercadopago_orders
         (
            order_id,
            customer_id,
            external_reference,
            return_token,
            tracking_token_hash,
            idempotency_key,
            amount,
            currency,
            status,
            created_at,
            updated_at
         )
         VALUES(
            ?,?,?,?,?,?,?,?,
            'creating',
            NOW(),
            NOW()
         )"
    )->execute([
        $orderId,
        $customerId ?: null,
        'pending',
        $returnToken,
        hash('sha256',$trackingToken),
        $idempotency,
        $balance,
        $currency
    ]);

    $localId = (int)db()->lastInsertId();

    $external = 'SISACT-'.$orderId.'-'.$localId;

    db()->prepare(
        'UPDATE cp_mercadopago_orders
         SET external_reference=?
         WHERE id=?'
    )->execute([
        $external,
        $localId
    ]);

    $base = $cfg['base_url'];

    $returnBase =
        $base
        .'/mercadopago_retorno.php?r='
        .rawurlencode($returnToken);

    $amount = mp_money_string(
        $balance
    );

    $orderNumber = trim(
        (string)($order['order_number'] ?? '')
    );

    $title = $orderNumber !== ''
        ? 'Orden '.$orderNumber
        : 'Orden '.$orderId;

    /*
     * PAYLOAD MINIMAL V1.4
     *
     * Campos explícitamente necesarios o requeridos para el flujo.
     * Se eliminan temporalmente todos los extras.
     */
    $payload = [
        'type' => 'online',
        'processing_mode' => 'manual',
        'total_amount' => $amount,
        'external_reference' => $external,

        'config' => [
            'online' => [
                'success_url' =>
                    $returnBase.'&result=success',

                'failure_url' =>
                    $returnBase.'&result=failure',

                'pending_url' =>
                    $returnBase.'&result=pending',

                'auto_return' => 'approved',
            ],
        ],

        'items' => [[
            'title' => $title,
            'quantity' => 1,
            'unit_price' => $amount,
        ]],
    ];

    /*
     * En pruebas Mercado Pago requiere comprador de prueba.
     * En producción NO enviamos payer.
     */
    if ($cfg['mode'] === 'test') {
        $email = strtolower(
            trim(
                (string)$cfg['test_buyer_email']
            )
        );

        if (
            $email === ''
            || !filter_var(
                $email,
                FILTER_VALIDATE_EMAIL
            )
            || !str_ends_with(
                $email,
                '@testuser.com'
            )
        ) {
            throw new RuntimeException(
                'TEST_BUYER_EMAIL_INVALID: '
                .'configura el correo exacto '
                .'del Comprador de prueba @testuser.com.'
            );
        }

        $payload['payer'] = [
            'email'=>$email
        ];
    }

    try {
        $remote = mp_api_request(
            'POST',
            '/v1/orders',
            $payload,
            $idempotency
        );

        $mpOrderId = trim(
            (string)($remote['id'] ?? '')
        );

        $checkoutUrl = trim(
            (string)($remote['checkout_url'] ?? '')
        );

        if (
            $mpOrderId === ''
            || $checkoutUrl === ''
        ) {
            throw new RuntimeException(
                'INVALID_RESPONSE: '
                .'Mercado Pago no devolvió '
                .'order id o checkout_url.'
            );
        }

        db()->prepare(
            'UPDATE cp_mercadopago_orders
             SET mp_order_id=?,
                 checkout_url=?,
                 status=?,
                 status_detail=?,
                 live_mode=?,
                 error_message=NULL,
                 updated_at=NOW()
             WHERE id=?'
        )->execute([
            $mpOrderId,
            $checkoutUrl,
            (string)($remote['status'] ?? 'created'),
            (string)($remote['status_detail'] ?? 'created'),
            isset($remote['live_mode'])
                ? ((bool)$remote['live_mode'] ? 1 : 0)
                : null,
            $localId
        ]);

        $st = db()->prepare(
            'SELECT *
             FROM cp_mercadopago_orders
             WHERE id=?
             LIMIT 1'
        );

        $st->execute([
            $localId
        ]);

        return $st->fetch() ?: [];
    } catch (Throwable $e) {
        mp_save_error(
            $localId,
            $e
        );

        throw $e;
    }
}

function mp_extract_payment_info(array $remote): array
{
    $out=[
        'id'=>null,
        'method_id'=>null,
        'method_type'=>null,
        'status'=>null,
        'status_detail'=>null,
    ];

    $payments =
        $remote['transactions']['payments']
        ?? [];

    if (!is_array($payments)) {
        return $out;
    }

    $chosen = null;

    foreach ($payments as $payment) {
        if (!is_array($payment)) {
            continue;
        }

        if (
            (string)($payment['status'] ?? '')
            === 'processed'
        ) {
            $chosen = $payment;
            break;
        }

        if ($chosen === null) {
            $chosen = $payment;
        }
    }

    if (!is_array($chosen)) {
        return $out;
    }

    $pm = is_array(
        $chosen['payment_method'] ?? null
    )
        ? $chosen['payment_method']
        : [];

    $out['id'] =
        isset($chosen['id'])
        ? (string)$chosen['id']
        : null;

    $out['method_id'] =
        isset($pm['id'])
        ? (string)$pm['id']
        : null;

    $out['method_type'] =
        isset($pm['type'])
        ? (string)$pm['type']
        : null;

    $out['status'] =
        isset($chosen['status'])
        ? (string)$chosen['status']
        : null;

    $out['status_detail'] =
        isset($chosen['status_detail'])
        ? (string)$chosen['status_detail']
        : null;

    return $out;
}

function mp_finance_method(
    ?string $type,
    ?string $id
): string {
    $type = strtolower(
        trim((string)$type)
    );

    $id = strtolower(
        trim((string)$id)
    );

    if (
        in_array(
            $type,
            [
                'credit_card',
                'debit_card',
                'prepaid_card'
            ],
            true
        )
    ) {
        return 'card';
    }

    if (
        in_array(
            $type,
            [
                'bank_transfer',
                'account_money'
            ],
            true
        )
    ) {
        return 'transfer';
    }

    if ($id === 'oxxo') {
        return 'oxxo';
    }

    if (
        in_array(
            $type,
            [
                'ticket',
                'atm'
            ],
            true
        )
    ) {
        return 'deposit';
    }

    return 'other';
}

function mp_apply_approved_payment(
    int $localId,
    array $remote
): void {
    db()->beginTransaction();

    try {
        $st = db()->prepare(
            'SELECT *
             FROM cp_mercadopago_orders
             WHERE id=?
             FOR UPDATE'
        );

        $st->execute([
            $localId
        ]);

        $local = $st->fetch();

        if (!$local) {
            throw new RuntimeException(
                'Transacción local no encontrada.'
            );
        }

        if (
            (int)($local['cp_payment_id'] ?? 0)
            > 0
        ) {
            db()->commit();
            return;
        }

        $remoteTotal = round(
            (float)($remote['total_amount'] ?? 0),
            2
        );

        $expected = round(
            (float)$local['amount'],
            2
        );

        if (
            $remoteTotal <= 0
            || abs(
                $remoteTotal - $expected
            ) > 0.01
        ) {
            db()->prepare(
                "UPDATE cp_mercadopago_orders
                 SET status='review',
                     error_message=?,
                     updated_at=NOW()
                 WHERE id=?"
            )->execute([
                'El total remoto no coincide '
                .'con el monto esperado.',
                $localId
            ]);

            db()->commit();
            return;
        }

        $pi = mp_extract_payment_info(
            $remote
        );

        $method = mp_finance_method(
            $pi['method_type'],
            $pi['method_id']
        );

        $reference =
            'MP:'
            .(
                $pi['id']
                ?: (string)$local['mp_order_id']
            );

        db()->prepare(
            "INSERT INTO cp_payments
             (
                order_id,
                customer_id,
                amount,
                payment_date,
                method,
                reference,
                note,
                status,
                created_by,
                updated_by,
                created_at,
                updated_at
             )
             VALUES(
                ?,?,?,?,?,?,?,
                'confirmed',
                NULL,
                NULL,
                NOW(),
                NOW()
             )"
        )->execute([
            (int)$local['order_id'],
            (int)($local['customer_id'] ?? 0)
                ?: null,
            $expected,
            date('Y-m-d'),
            $method,
            $reference,
            'Pago acreditado automáticamente '
            .'por Mercado Pago · Order '
            .(string)$local['mp_order_id']
        ]);

        $cpPaymentId =
            (int)db()->lastInsertId();

        db()->prepare(
            'UPDATE cp_mercadopago_orders
             SET cp_payment_id=?,
                 mp_payment_id=?,
                 payment_method_id=?,
                 payment_method_type=?,
                 paid_at=NOW(),
                 updated_at=NOW(),
                 error_message=NULL
             WHERE id=?'
        )->execute([
            $cpPaymentId,
            $pi['id'],
            $pi['method_id'],
            $pi['method_type'],
            $localId
        ]);

        db()->commit();
    } catch (Throwable $e) {
        if (db()->inTransaction()) {
            db()->rollBack();
        }

        throw $e;
    }
}

function mp_sync_remote_order(
    string $mpOrderId
): ?array {
    if (
        !mp_table_ready()
        || $mpOrderId === ''
    ) {
        return null;
    }

    $st = db()->prepare(
        'SELECT *
         FROM cp_mercadopago_orders
         WHERE mp_order_id=?
         LIMIT 1'
    );

    $st->execute([
        $mpOrderId
    ]);

    $local = $st->fetch();

    if (!$local) {
        return null;
    }

    $remote = mp_api_request(
        'GET',
        '/v1/orders/'
        .rawurlencode($mpOrderId)
    );

    $remoteExternal = trim(
        (string)(
            $remote['external_reference']
            ?? ''
        )
    );

    if (
        $remoteExternal === ''
        || !hash_equals(
            (string)$local['external_reference'],
            $remoteExternal
        )
    ) {
        throw new RuntimeException(
            'La referencia de Mercado Pago '
            .'no coincide con SISACT.'
        );
    }

    $status = trim(
        (string)($remote['status'] ?? 'unknown')
    );

    $detail = trim(
        (string)($remote['status_detail'] ?? '')
    );

    $pi = mp_extract_payment_info(
        $remote
    );

    db()->prepare(
        'UPDATE cp_mercadopago_orders
         SET status=?,
             status_detail=?,
             mp_payment_id=COALESCE(?,mp_payment_id),
             payment_method_id=COALESCE(?,payment_method_id),
             payment_method_type=COALESCE(?,payment_method_type),
             updated_at=NOW()
         WHERE id=?'
    )->execute([
        $status,
        $detail !== ''
            ? $detail
            : null,
        $pi['id'],
        $pi['method_id'],
        $pi['method_type'],
        (int)$local['id']
    ]);

    if (
        $status === 'processed'
        && $detail === 'accredited'
    ) {
        mp_apply_approved_payment(
            (int)$local['id'],
            $remote
        );
    }

    $st = db()->prepare(
        'SELECT *
         FROM cp_mercadopago_orders
         WHERE id=?
         LIMIT 1'
    );

    $st->execute([
        (int)$local['id']
    ]);

    return $st->fetch() ?: null;
}

function mp_sync_pending_for_order(
    int $orderId,
    int $minimumAgeSeconds = 20
): ?array {
    if (
        !mp_table_ready()
        || !mp_configured()
        || $orderId <= 0
    ) {
        return null;
    }

    $st = db()->prepare(
        "SELECT *
         FROM cp_mercadopago_orders
         WHERE order_id=?
           AND mp_order_id IS NOT NULL
           AND mp_order_id<>''
           AND cp_payment_id IS NULL
           AND status IN (
               'created',
               'processing',
               'action_required'
           )
         ORDER BY id DESC
         LIMIT 1"
    );

    $st->execute([
        $orderId
    ]);

    $local = $st->fetch();

    if (!$local) {
        return null;
    }

    $updated = strtotime(
        (string)($local['updated_at'] ?? '')
    );

    if (
        $updated
        && (
            time() - $updated
        ) < max(
            0,
            $minimumAgeSeconds
        )
    ) {
        return $local;
    }

    try {
        return mp_sync_remote_order(
            (string)$local['mp_order_id']
        );
    } catch (Throwable $e) {
        error_log(
            '[SISACT][MercadoPago][sync_order] '
            .$e->getMessage()
        );

        return $local;
    }
}

function mp_sync_pending_transactions(
    int $limit = 30
): array {
    $result = [
        'checked'=>0,
        'paid'=>0,
        'errors'=>0,
    ];

    if (
        !mp_table_ready()
        || !mp_configured()
    ) {
        return $result;
    }

    $limit = max(
        1,
        min(
            100,
            $limit
        )
    );

    $rows = db()->query(
        "SELECT id,mp_order_id
         FROM cp_mercadopago_orders
         WHERE mp_order_id IS NOT NULL
           AND mp_order_id<>''
           AND cp_payment_id IS NULL
           AND status IN (
               'created',
               'processing',
               'action_required'
           )
           AND created_at>=DATE_SUB(
               NOW(),
               INTERVAL 7 DAY
           )
         ORDER BY id ASC
         LIMIT {$limit}"
    )->fetchAll() ?: [];

    foreach ($rows as $row) {
        $result['checked']++;

        try {
            $synced =
                mp_sync_remote_order(
                    (string)$row['mp_order_id']
                );

            if (
                $synced
                && (int)(
                    $synced['cp_payment_id']
                    ?? 0
                ) > 0
            ) {
                $result['paid']++;
            }
        } catch (Throwable $e) {
            $result['errors']++;

            error_log(
                '[SISACT][MercadoPago][sync_pending] '
                .(string)$row['mp_order_id']
                .' '
                .$e->getMessage()
            );
        }
    }

    return $result;
}

function mp_transaction_by_return_token(
    string $returnToken
): ?array {
    if (
        !mp_table_ready()
        || !preg_match(
            '/^[a-f0-9]{64}$/i',
            $returnToken
        )
    ) {
        return null;
    }

    $st = db()->prepare(
        'SELECT *
         FROM cp_mercadopago_orders
         WHERE return_token=?
         LIMIT 1'
    );

    $st->execute([
        $returnToken
    ]);

    return $st->fetch() ?: null;
}

function mp_recent_transactions(
    int $limit = 30
): array {
    if (!mp_table_ready()) {
        return [];
    }

    $limit = max(
        1,
        min(
            100,
            $limit
        )
    );

    return db()->query(
        "SELECT
            m.*,
            o.order_number,
            c.name AS customer_name
         FROM cp_mercadopago_orders m
         INNER JOIN cp_orders o
            ON o.id=m.order_id
         LEFT JOIN cp_customers c
            ON c.id=m.customer_id
         ORDER BY m.id DESC
         LIMIT {$limit}"
    )->fetchAll() ?: [];
}

function mp_last_attempt(): ?array
{
    if (!mp_table_ready()) {
        return null;
    }

    $st = db()->query(
        "SELECT
            m.id,
            m.order_id,
            m.status,
            m.status_detail,
            m.error_message,
            m.mp_order_id,
            m.created_at,
            m.updated_at,
            o.order_number
         FROM cp_mercadopago_orders m
         LEFT JOIN cp_orders o
            ON o.id=m.order_id
         ORDER BY m.id DESC
         LIMIT 1"
    );

    return $st->fetch() ?: null;
}

function mp_last_error(): ?array
{
    if (!mp_table_ready()) {
        return null;
    }

    $st = db()->query(
        "SELECT
            m.id,
            m.order_id,
            m.error_message,
            m.created_at,
            m.updated_at,
            o.order_number
         FROM cp_mercadopago_orders m
         LEFT JOIN cp_orders o
            ON o.id=m.order_id
         WHERE m.status='error'
           AND m.error_message IS NOT NULL
         ORDER BY m.id DESC
         LIMIT 1"
    );

    return $st->fetch() ?: null;
}
